{
  "name": "Generate Notifications",
  "description": "Every hour, scans all clinics for upcoming appointments, overdue lab cases, and outstanding patient balances, then creates in-app notifications for the relevant users (doctors, receptionists, clinic admins). Avoids duplicates within a 24h window.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_notifications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateNotifications",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Generate operational notifications",
            "description": "Scan clinics and create in-app notifications"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Istanbul",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}