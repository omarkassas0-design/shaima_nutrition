{
  "name": "Expense",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "Associated clinic ID (auto-assigned server-side from the authenticated user)"
    },
    "name": {
      "type": "string",
      "description": "Expense name/description"
    },
    "amount": {
      "type": "number",
      "description": "Expense amount"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "SYP",
        "TRY",
        "EUR"
      ],
      "default": "USD"
    },
    "expense_date": {
      "type": "string",
      "format": "date",
      "description": "Expense date"
    },
    "category": {
      "type": "string",
      "description": "Expense category (rent, utilities, supplies, equipment, other)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "clinic_id",
    "name",
    "amount",
    "expense_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}